{
  "name": "cookie-copier",
  "version": "0.2.0",
  "description": "Chrome extension that exports the active site's cookies.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package.mjs",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10"
  }
}

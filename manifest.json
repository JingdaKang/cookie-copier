{
  "manifest_version": 3,
  "name": "Cookie Copier",
  "version": "0.2.0",
  "description": "Copy or export the current site's cookies as a Cookie header, JSON, or CSV, scoped to its domain.",
  "permissions": ["activeTab", "cookies", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Cookie Copier",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
